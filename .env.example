# Application
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/backend_dinamico?schema=public"

# JWT (use a random 64+ char string in production: openssl rand -hex 64)
JWT_SECRET=change-me-use-a-long-random-string
JWT_EXPIRES_IN=8h

# Azure AD / Microsoft Entra ID
# tenantId and clientId come from the app registration in Azure Portal
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here

# Admin API key (use a random 64+ char string in production)
ADMIN_API_KEY=change-me-use-a-long-random-string

# CORS — comma-separated list of allowed origins (omit to allow '*' in dev, deny all in prod)
# Example: CORS_ORIGINS=https://sith.coopgualaquiza.fin.ec,https://admin.coopgualaquiza.fin.ec
CORS_ORIGINS=http://localhost:4200
