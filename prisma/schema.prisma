/// Solicitud de permiso laboral vinculada 1:1 a una instancia de workflow.
/// @unique en idInstanciaWorkflow garantiza idempotencia del handler SOLICITAR_PERMISO.
model Tsolicitudpermisos {
  id                  Int                    @id @default(autoincrement())
  /// FK a la instancia de workflow que gestiona esta solicitud
  idInstanciaWorkflow Int                    @unique @map("id_instancia_workflow")
  usuarioSolicitante  String                 @map("usuario_solicitante") @db.VarChar(100)
  tipoPermiso         String                 @map("tipo_permiso") @db.VarChar(100)
  fechaInicio         DateTime               @map("fecha_inicio") @db.Date
  fechaFin            DateTime               @map("fecha_fin") @db.Date
  motivoPermiso       String?                @map("motivo_permiso") @db.VarChar(500)
  estado              EstadoSolicitudPermiso @default(PENDIENTE)
  motivoRechazo       String?                @map("motivo_rechazo") @db.Text
  usuarioAprobador    String?                @map("usuario_aprobador") @db.VarChar(100)
  fechaResolucion     DateTime?              @map("fecha_resolucion")
  usuarioCreacion     String                 @map("usuario_creacion") @db.VarChar(100)
  fechaCreacion       DateTime               @default(now()) @map("fecha_creacion")
  usuarioModificacion String?                @map("usuario_modificacion") @db.VarChar(100)
  fechaModificacion   DateTime?              @map("fecha_modificacion")

  instanciaWorkflow Tprocesoinstancia @relation(fields: [idInstanciaWorkflow], references: [id])

  @@index([usuarioSolicitante])
  @@map("tsolicitudpermisos")
}

/// Mapeo empleado → jefe directo para el resolver JEFE_DEL_SOLICITANTE.
/// Tabla mínima para la demo; en producción se integraría con el directorio RRHH.
model Tjefeempleado {
  cempleado String @id @db.VarChar(100)
  cjefe     String @db.VarChar(100)

  @@index([cjefe])
  @@map("tjefeempleado")
}

// ============================================================
// SEGURIDAD — USUARIOS
// Tabla de credenciales locales para autenticación cedula + contraseña.
// En producción podría delegarse a un IdP externo sin cambiar el motor.
// ============================================================

/// Credenciales de acceso al sistema.
/// Autenticación exclusivamente vía Azure AD (azureOid).
model Tusuario {
  cempleado         String    @id @db.VarChar(100)
  /// OID de Azure AD — identificador inmutable de la identidad corporativa
  azureOid          String?   @unique @map("azure_oid") @db.VarChar(200)
  cedula            String    @unique @db.VarChar(20)
  nombre            String    @db.VarChar(200)
  cargo             String?   @db.VarChar(100)
  departamento      String?   @db.VarChar(100)
  email             String?   @db.VarChar(200)
  agencia           String?   @db.VarChar(100)
  rol               RolUsuario @default(EMPLEADO)
  activo            Boolean    @default(true)
  fechaCreacion     DateTime   @default(now()) @map("fecha_creacion")
  fechaModificacion DateTime?  @map("fecha_modificacion")

  @@map("tusuario")
}
